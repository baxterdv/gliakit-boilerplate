# ── GliaKit starter ──────────────────────────────────────────────
# Every key is OPTIONAL. The app runs fully on demo data without any.
# Add a key, restart the dev server, and that integration switches on.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Prisma · SQLite by default)
# npx prisma db push && npm run db:seed
DATABASE_URL="file:./dev.db"

# Auth (Clerk) — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Payments (Stripe) — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PRICE_TEAM=

# Email (Resend) — https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM="GliaKit <noreply@yourdomain.com>"

# Search engines — set to 1 on a staging or demo deployment to keep every page out of search
NOINDEX=
